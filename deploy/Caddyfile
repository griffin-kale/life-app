# Holt das HTTPS-Zertifikat automatisch und leitet an die App weiter.
{$DOMAIN} {
	encode zstd gzip
	# Größer ist keine Anfrage an Life. Fotos kommen im Browser verkleinert an (unter 2 MB), Rest ist Text.
	request_body {
		max_size 8MB
	}
	# Zugriffe 14 Tage aufbewahren, für Fehlersuche und Angriffe. Ohne Query-Strings und ohne Kopfzeilen,
	# damit keine Schlüssel, Codes oder Cookies im Log landen.
	log {
		output file /data/logs/access.log {
			roll_size 10MiB
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ""
				request>headers delete
				resp_headers delete
			}
		}
	}
	reverse_proxy app:3000
}
