# Datenbank (läuft im selben Server, siehe deploy/docker-compose.yml)
DATABASE_URL=postgres://life:PASSWORT@db:5432/life
# Öffentliche Adresse der App, legt die Domain für Passkeys fest
PUBLIC_ORIGIN=https://life.deinedomain.de
# Zufällige lange Werte, z. B. mit: openssl rand -base64 48
SESSION_SECRET=
# Schlüssel für gespeicherte Geheimnisse (Einmal-Code, WHOOP, Push). Nie wieder entfernen, sobald gesetzt.
ENCRYPTION_KEY=
SETUP_TOKEN=
CAPTURE_TOKEN=
# Claude über die Anthropic-API der Griffin & Kale GmbH. Alles geht vorher durch die Pseudonymisierung (lib/pseudonym.ts).
ANTHROPIC_API_KEY=
# Optional, sonst gelten die Standards aus lib/claude.ts
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODEL_DEEP=claude-opus-5-5
# Optional: WHOOP (developer.whoop.com), Kalender aus iCloud (app-spezifisches Passwort), Rückmeldungen als GitHub-Issue
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
ICLOUD_USER=
ICLOUD_APP_PASSWORT=
GITHUB_ISSUES_TOKEN=
# Fertige Images von GitHub statt Bauen auf dem Server
GHCR_IMAGE=
